{
  "expo": {
    "name": "RentLoop",
    "slug": "borrow-hub",
    "description": "Thuê và chia sẻ đồ dùng an toàn trong cộng đồng RentLoop.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-v2.png",
    "scheme": "rentloop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-icon-v2.png",
      "bundleIdentifier": "com.rentloop.app"
    },
    "android": {
      "package": "com.rentloop.app",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#4F7C6B",
        "foregroundImage": "./assets/images/android-icon-foreground-v2.png",
        "monochromeImage": "./assets/images/android-icon-foreground-v2.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "primaryColor": "#4F7C6B",
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4F7C6B",
          "image": "./assets/images/splash-icon-v2.png",
          "imageWidth": 132
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép RentLoop dùng camera để quét mã bàn giao."
        }
      ],
      "expo-image",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c677627f-707a-4214-bdad-9e4b294f9e40"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c677627f-707a-4214-bdad-9e4b294f9e40"
    }
  }
}
