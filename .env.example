# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
APP_URL=http://localhost:3000
DOMAIN=api.example.com
ACME_EMAIL=admin@example.com
API_PORT=3000
API_BIND_ADDRESS=127.0.0.1
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
SWAGGER_ENABLED=true

# PostgreSQL
POSTGRES_DB=borrowhub
POSTGRES_USER=borrowhub
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://borrowhub:replace-with-a-strong-database-password@localhost:5432/borrowhub?schema=public
DOCKER_DATABASE_URL=postgresql://borrowhub:replace-with-a-url-encoded-database-password@postgres:5432/borrowhub?schema=public

# Redis
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=redis://localhost:6379
DOCKER_REDIS_URL=redis://:replace-with-a-url-encoded-redis-password@redis:6379
CACHE_TTL_MS=60000
CACHE_KEY_PREFIX=borrowhub

# Authentication and private file signatures (use independent random values)
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-access
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-refresh
STORAGE_SIGNING_SECRET=replace-with-at-least-32-random-characters-storage
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PASSWORD_RESET_URL=http://localhost:8081/auth/reset-password
ACCOUNT_DELETION_URL=https://api.example.com/account-deletion
SUPPORT_EMAIL=support@example.com

# SMTP (required when NODE_ENV=production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_FROM=Borrow Hub <no-reply@example.com>

# SePay / VietQR (required and enabled in production)
SEPAY_ENABLED=false
SEPAY_ACCOUNT_NUMBER=replace-with-bank-account-number
SEPAY_ACCOUNT_NAME=CONG TY BORROW HUB
SEPAY_BANK_NAME=Vietcombank
SEPAY_WEBHOOK_SECRET=replace-with-at-least-32-random-characters-sepay

# Abuse controls and business rules
THROTTLE_TTL=60
THROTTLE_LIMIT=120
PLATFORM_FEE_PERCENT=5
OWNER_COMMISSION_PERCENT=10
LATE_FEE_RATE=10000
MAX_NEW_USER_ASSET_VALUE=3000000
REVIEW_EDIT_HOURS=24
CONTRACT_VERSION=v1

# Storage and logging
UPLOADS_DIR=./uploads
LOG_TO_FILES=false
LOGS_DIR=./logs
REQUEST_LOG_RETENTION_DAYS=30

# Expo mobile build (configure in apps/mobile/.env or EAS environment)
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_LEGAL_BASE_URL=http://localhost:3000
